// Prisma Schema for Artron Multi-Tenant Architecture
// PostgreSQL Database Provider

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  subdomain     String         @unique
  plan          String         @default("ENTERPRISE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  subscriptions Subscription[]
  turnstileLogs TurnstileLog[]
  federations   Federation[]
  clubs         Club[]
  athletes      Athlete[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  passwordHash        String
  name                String
  personalIdEncrypted String?                  @unique
  personalIdIv        String?
  personalIdAuthTag   String?
  role                UserRole                 @default(CLUB_ADMIN)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  tenantId            String
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions       Subscription[]
  turnstileLogs       TurnstileLog[]
  deletionRequests    AccountDeletionRequest[]
  auditLogs           AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model Federation {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String   @unique
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clubs     Club[]

  @@index([tenantId])
  @@map("federations")
}

model Club {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  federationId String?
  federation   Federation? @relation(fields: [federationId], references: [id], onDelete: SetNull)
  name         String
  academyType  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  athletes     Athlete[]

  @@index([tenantId])
  @@index([federationId])
  @@map("clubs")
}

model Athlete {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clubId         String?
  club           Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  biometricsJson Json?
  piiEncrypted   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([clubId])
  @@map("athletes")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

model Subscription {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id])
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                String
  status              SubscriptionStatus @default(ACTIVE)
  price               Float
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime           @default(now())
  refundEligibleUntil DateTime
  refundedAt          DateTime?

  @@index([tenantId])
  @@index([userId])
  @@map("subscriptions")
}

model TurnstileLog {
  id        String             @id @default(uuid())
  timestamp DateTime           @default(now())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  direction TurnstileDirection

  @@index([tenantId])
  @@index([userId])
  @@map("turnstile_logs")
}

model AccountDeletionRequest {
  id                 String                @id @default(uuid())
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt        DateTime              @default(now())
  scheduledPurgeAt   DateTime
  taxArchiveRequired Boolean               @default(false)
  status             DeletionRequestStatus @default(PENDING)

  @@index([userId])
  @@map("deletion_requests")
}

enum UserRole {
  SUPER_ADMIN
  FEDERATION_ADMIN
  CLUB_ADMIN
  STAFF_COACH
  STAFF_MEDIC
  ATHLETE
  CUSTOMER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

enum TurnstileDirection {
  IN
  OUT
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}
